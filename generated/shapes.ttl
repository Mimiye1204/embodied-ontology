eo:ObjectShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:created_at ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path eo:deprecated ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:description ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path eo:has_handle ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path eo:has_thread ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path eo:is_container ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path eo:is_fragile ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:label ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:object_code ],
        [ sh:in ( "dry" "rough" "slippery" ) ;
            sh:maxCount 1 ;
            sh:path eo:surface ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path eo:updated_at ],
