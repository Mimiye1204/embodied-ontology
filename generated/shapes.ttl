eo:AtSiteTargetExistsShape a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "悬空引用：{$this} 的 at_site 指向数据集中不存在的实体" ;
            sh:prefixes eo: ;
            sh:select "SELECT $this ?o WHERE { $this eo:at_site ?o . FILTER NOT EXISTS { ?o ?p ?v } }" ] ;
