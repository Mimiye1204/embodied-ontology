            sh:path eo:label ],
        [ sh:class eo:FaultMode ;
            sh:maxCount 1 ;
            sh:path eo:of_mode ],
        [ sh:class eo:Robot ;
            sh:maxCount 1 ;
            sh:path eo:reported_by ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path eo:resolved_at ],
        [ sh:in ( "critical" "info" "warning" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:severity ],
        [ sh:in ( "acknowledged" "active" "resolved" ) ;
            sh:maxCount 1 ;
            sh:path eo:status ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path eo:updated_at ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path eo:version ] ;
    sh:targetClass eo:FaultEvent .

