            sh:path eo:deprecated ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:description ],
        [ sh:class eo:Object ;
            sh:maxCount 1 ;
            sh:path eo:involves_object ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:label ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:path eo:priority ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:maxInclusive 100 ;
            sh:minInclusive 0 ;
            sh:path eo:progress ],
        [ sh:class eo:Capability ;
            sh:minCount 1 ;
            sh:path eo:requires_capability ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:status ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path eo:updated_at ],
        [ sh:in ( "constrained" "feasible" "infeasible" "rewrite" ) ;
            sh:maxCount 1 ;
            sh:path eo:verdict ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path eo:version ] ;
    sh:targetClass eo:Task .

eo:TelemetryMetricMetricCodeKeyUniqueShape a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "唯一键冲突（metric_code_key）：{$this}" ;
            sh:prefixes eo: ;
            sh:select """SELECT $this ?other WHERE {
                    $this eo:metric_code ?v_metric_code .
                    ?other eo:metric_code ?v_metric_code .
                    FILTER (?other != $this && bound(?v_metric_code)) }""" ] ;
    sh:targetClass eo:TelemetryMetric .

eo:TelemetryMetricShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:in ( "avg" "count" "last" "max" "min" "rate" ) ;
            sh:maxCount 1 ;
            sh:path eo:aggregation ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:binds_to ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:created_at ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path eo:deprecated ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:label ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:path eo:max_value ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path eo:measures ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:metric_code ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:path eo:min_value ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 1 ;
            sh:path eo:retention_days ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path eo:sampling_hz ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:unit ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path eo:updated_at ],
        [ sh:in ( "bool" "float" "int" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:value_type ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path eo:version ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:path eo:window_seconds ] ;
    sh:targetClass eo:TelemetryMetric .

eo:TelemetryPointShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:created_at ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path eo:deprecated ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:description ],
        [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path eo:entity_ref ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:label ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:metric_code ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:time ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path eo:updated_at ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:value ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path eo:version ] ;
    sh:targetClass eo:TelemetryPoint .

