eo:ConstraintShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path eo:constrains ],
        [ sh:in ( "gripper" "load" "pose" "speed" "torque" "workspace" ) ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:constraint_type ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:created_at ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path eo:deprecated ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:expression ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:label ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:suggested_rewrite ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:path eo:threshold ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:unit ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path eo:updated_at ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path eo:version ] ;
    sh:targetClass eo:Constraint .

