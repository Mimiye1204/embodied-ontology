eo:RobotShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:created_at ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:maxInclusive 100 ;
            sh:minInclusive 0 ;
            sh:path eo:current_battery ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path eo:deprecated ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:firmware_version ],
        [ sh:class eo:BodyPart ;
            sh:path eo:has_part ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:label ],
        [ sh:class eo:Site ;
            sh:maxCount 1 ;
            sh:path eo:located_at ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:model ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:serial ],
        [ sh:in ( "decommissioned" "maintenance" "offline" "online" ) ;
            sh:maxCount 1 ;
            sh:path eo:status ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path eo:updated_at ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path eo:version ] ;
    sh:targetClass eo:Robot .

