@prefix eo: <https://ontology.huilun.cn/embodied/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

eo:ActionLogShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:action_type ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:actor ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:created_at ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path eo:deprecated ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:detail ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:label ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:occurred_at ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:result ],
        [ sh:maxCount 1 ;
            sh:nodeKind sh:IRI ;
            sh:path eo:target ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path eo:updated_at ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path eo:version ] ;
    sh:targetClass eo:ActionLog .

eo:AffectsBodypartTargetExistsShape a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "悬空引用：{$this} 的 affects_bodypart 指向数据集中不存在的实体" ;
            sh:prefixes eo: ;
            sh:select "SELECT $this ?o WHERE { $this eo:affects_bodypart ?o . FILTER NOT EXISTS { ?o ?p ?v } }" ] ;
    sh:targetSubjectsOf eo:affects_bodypart .

eo:AffectsCapabilityTargetExistsShape a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "悬空引用：{$this} 的 affects_capability 指向数据集中不存在的实体" ;
            sh:prefixes eo: ;
            sh:select "SELECT $this ?o WHERE { $this eo:affects_capability ?o . FILTER NOT EXISTS { ?o ?p ?v } }" ] ;
    sh:targetSubjectsOf eo:affects_capability .

eo:AssignedToTargetExistsShape a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
