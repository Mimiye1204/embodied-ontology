eo:FaultEventShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:class eo:BodyPart ;
            sh:path eo:affects_bodypart ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:created_at ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path eo:deprecated ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:description ],
        [ sh:datatype xsd:dateTime ;
