            sh:minInclusive 0 ;
            sh:path eo:version ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path eo:weight_kg ] ;
    sh:targetClass eo:Object .

