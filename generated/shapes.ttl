eo:BodyPartShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:created_at ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:path eo:current_angle ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path eo:current_force ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path eo:deprecated ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:description ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path eo:dof ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path eo:grip_force_n ],
        [ sh:in ( "degraded" "fault" "ok" ) ;
            sh:maxCount 1 ;
            sh:path eo:health ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:label ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path eo:load_capacity_kg ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path eo:max_speed_ms ],
        [ sh:class eo:BodyPart ;
            sh:maxCount 1 ;
            sh:path eo:part_of ],
        [ sh:class eo:Capability ;
            sh:path eo:provides_capability ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path eo:torque_limit_nm ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path eo:updated_at ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path eo:version ] ;
    sh:targetClass eo:BodyPart .

eo:CapabilityCapabilityCodeKeyUniqueShape a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "唯一键冲突（capability_code_key）：{$this}" ;
            sh:prefixes eo: ;
            sh:select """SELECT $this ?other WHERE {
                    $this eo:code ?v_code .
                    ?other eo:code ?v_code .
                    FILTER (?other != $this && bound(?v_code)) }""" ] ;
    sh:targetClass eo:Capability .

eo:CapabilityShape a sh:NodeShape ;
    sh:closed true ;
    sh:ignoredProperties ( rdf:type ) ;
    sh:nodeKind sh:IRI ;
    sh:property [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:code ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:created_at ],
        [ sh:datatype xsd:boolean ;
            sh:maxCount 1 ;
            sh:path eo:deprecated ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:path eo:description ],
        [ sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path eo:label ],
        [ sh:datatype xsd:double ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path eo:payload_kg ],
        [ sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:path eo:updated_at ],
        [ sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:path eo:version ] ;
    sh:targetClass eo:Capability .

eo:ConstrainsTargetExistsShape a sh:NodeShape ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "悬空引用：{$this} 的 constrains 指向数据集中不存在的实体" ;
