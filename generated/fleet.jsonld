      "id": "eo:cap/speech",
      "type": "Capability",
      "code": "speech",
      "created_at": "2026-11-20T08:00:00+08:00",
      "label": "语音交互"
    },
    {
      "id": "eo:constraint/arm-load-limit",
      "type": "Constraint",
      "constraint_type": "load",
      "created_at": "2026-11-20T08:00:00+08:00",
      "expression": "m ≤ 3.0 kg",
      "label": "臂负载上限",
      "suggested_rewrite": "改用底盘推行，或分解为多次搬运",
      "threshold": 3.0,
      "unit": "kg",
      "constrains": "eo:part/ti5/arm"
    },
    {
      "id": "eo:constraint/grip-force-limit",
      "type": "Constraint",
      "constraint_type": "gripper",
      "created_at": "2026-11-20T08:00:00+08:00",
      "expression": "F = m·g·k_surface ≤ 40 N",
      "label": "抓握力上限",
      "suggested_rewrite": "改用双手协同或增大夹持接触面积",
      "threshold": 40.0,
      "unit": "N",
      "constrains": "eo:part/ti5/dexterous-hand"
    },
    {
      "id": "eo:constraint/no-hip",
      "type": "Constraint",
      "constraint_type": "pose",
      "created_at": "2026-11-20T08:00:00+08:00",
      "expression": "sitting 需臀部支撑；折叠腿无臀部位形",
      "label": "无臀部位形限制",
      "suggested_rewrite": "改写任务意义：不做「坐下」，改为「靠近并语音指引」",
      "constrains": "eo:part/ti5/leg"
    },
    {
      "id": "eo:constraint/wrist-torque-limit",
      "type": "Constraint",
      "constraint_type": "torque",
      "created_at": "2026-11-20T08:00:00+08:00",
      "expression": "τ = m·g·l ≤ 0.5 N·m（l=0.3 m）",
      "label": "腕力矩上限",
      "suggested_rewrite": "先减轻负载（容器可倒水）或缩短力臂/双手协作",
      "threshold": 0.5,
      "unit": "Nm",
      "constrains": "eo:part/ti5/wrist"
    },
    {
      "id": "eo:event/fault-001",
      "type": "FaultEvent",
      "created_at": "2026-11-24T10:30:00+08:00",
